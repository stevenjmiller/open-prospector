{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprospector.invalid/v0/alternative.schema.json",
  "title": "Structured contestation alternative v0",
  "type": "object",
  "required": [
    "schema_version", "alternative_id", "contestation_id", "kind", "preserved_goal_id",
    "hazard_id", "proposed_cell", "budget_delta", "requested_evidence", "summary_template_id", "summary"
  ],
  "properties": {
    "schema_version": { "const": "alternative-v0" },
    "alternative_id": { "$ref": "common.schema.json#/$defs/Id" },
    "contestation_id": { "$ref": "common.schema.json#/$defs/Id" },
    "kind": { "enum": ["substitute-vantage", "substitute-target"] },
    "preserved_goal_id": { "$ref": "common.schema.json#/$defs/Id" },
    "hazard_id": { "$ref": "common.schema.json#/$defs/Id" },
    "proposed_cell": { "$ref": "common.schema.json#/$defs/GridCell" },
    "proposed_entity_id": { "$ref": "common.schema.json#/$defs/Id" },
    "proposed_route": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/GridCell" }
    },
    "budget_delta": {
      "type": "object",
      "required": ["duration_ticks", "traverse_mm", "energy_units", "tier2_bytes"],
      "properties": {
        "duration_ticks": { "$ref": "common.schema.json#/$defs/SafeInteger" },
        "traverse_mm": { "$ref": "common.schema.json#/$defs/SafeInteger" },
        "energy_units": { "$ref": "common.schema.json#/$defs/SafeInteger" },
        "tier2_bytes": { "$ref": "common.schema.json#/$defs/SafeInteger" }
      },
      "additionalProperties": false
    },
    "requested_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/SuccessEvidence" }
    },
    "summary_template_id": { "enum": ["vantage.slice-v0", "target.slice-v0"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 512 }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "substitute-target" } }, "required": ["kind"] },
      "then": {
        "required": ["proposed_entity_id"],
        "properties": { "summary_template_id": { "const": "target.slice-v0" } }
      },
      "else": {
        "not": { "required": ["proposed_entity_id"] },
        "properties": { "summary_template_id": { "const": "vantage.slice-v0" } }
      }
    }
  ],
  "additionalProperties": false
}
