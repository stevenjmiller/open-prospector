{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprospector.invalid/v0/common.schema.json",
  "title": "Open Prospector v0 common types",
  "$defs": {
    "SafeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "NonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "CanonicalValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "string" },
        { "$ref": "#/$defs/SafeInteger" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/CanonicalValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/CanonicalValue" }
        }
      ]
    },
    "Tick": {
      "$ref": "#/$defs/NonNegativeInteger"
    },
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*:[a-zA-Z0-9._:-]+$"
    },
    "PointMm": {
      "type": "object",
      "required": ["e_mm", "n_mm"],
      "properties": {
        "e_mm": { "$ref": "#/$defs/SafeInteger" },
        "n_mm": { "$ref": "#/$defs/SafeInteger" },
        "u_mm": { "$ref": "#/$defs/SafeInteger" }
      },
      "additionalProperties": false
    },
    "GridCell": {
      "type": "object",
      "required": ["row", "column"],
      "properties": {
        "row": { "type": "integer", "minimum": 0, "maximum": 255 },
        "column": { "type": "integer", "minimum": 0, "maximum": 255 }
      },
      "additionalProperties": false
    },
    "GridRectangle": {
      "type": "object",
      "required": ["min_row", "max_row", "min_column", "max_column"],
      "properties": {
        "min_row": { "type": "integer", "minimum": 0, "maximum": 255 },
        "max_row": { "type": "integer", "minimum": 0, "maximum": 255 },
        "min_column": { "type": "integer", "minimum": 0, "maximum": 255 },
        "max_column": { "type": "integer", "minimum": 0, "maximum": 255 }
      },
      "additionalProperties": false
    },
    "EvidenceRef": {
      "type": "object",
      "required": ["artifact_id", "artifact_hash", "media_type"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/Id" },
        "artifact_hash": { "$ref": "#/$defs/Hash" },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "byte_length": { "$ref": "#/$defs/NonNegativeInteger" }
      },
      "additionalProperties": false
    },
    "Budget": {
      "type": "object",
      "required": ["duration_ticks", "traverse_mm", "energy_units", "tier2_bytes"],
      "properties": {
        "duration_ticks": { "$ref": "#/$defs/NonNegativeInteger" },
        "traverse_mm": { "$ref": "#/$defs/NonNegativeInteger" },
        "energy_units": { "$ref": "#/$defs/NonNegativeInteger" },
        "tier2_bytes": { "$ref": "#/$defs/NonNegativeInteger" }
      },
      "additionalProperties": false
    },
    "Goal": {
      "type": "object",
      "required": ["goal_id", "objective", "success_evidence"],
      "properties": {
        "goal_id": { "$ref": "#/$defs/Id" },
        "objective": { "type": "string", "minLength": 1, "maxLength": 512 },
        "success_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/SuccessEvidence" }
        }
      },
      "additionalProperties": false
    },
    "SuccessEvidence": {
      "enum": ["standoff-image", "spectral-characterization", "position-safe", "energy-reserve-met"]
    },
    "HazardClass": {
      "enum": [
        "terrain",
        "obstacle",
        "energy-reserve",
        "instrument-protection",
        "planetary-protection-adjacency",
        "communications",
        "asset-envelope",
        "campaign-conflict"
      ]
    }
  }
}
