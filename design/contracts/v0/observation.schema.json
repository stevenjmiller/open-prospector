{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprospector.invalid/v0/observation.schema.json",
  "title": "Observation and belief patch v0",
  "type": "object",
  "required": [
    "schema_version", "observation_id", "run_id", "asset_id", "sensor_id",
    "observed_tick", "observation_type", "truth_contact", "footprint_cells",
    "measurements", "belief_patch"
  ],
  "properties": {
    "schema_version": { "const": "observation-v0" },
    "observation_id": { "$ref": "common.schema.json#/$defs/Id" },
    "run_id": { "$ref": "common.schema.json#/$defs/Id" },
    "asset_id": { "$ref": "common.schema.json#/$defs/Id" },
    "sensor_id": { "$ref": "common.schema.json#/$defs/Id" },
    "observed_tick": { "$ref": "common.schema.json#/$defs/Tick" },
    "observation_type": { "enum": ["local-sweep", "obstacle-range", "standoff-image", "classifier-result"] },
    "truth_contact": { "type": "boolean" },
    "footprint_cells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/GridCell" }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "unit", "uncertainty_ppm"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "value": {
            "oneOf": [
              { "$ref": "common.schema.json#/$defs/SafeInteger" },
              { "type": "string", "minLength": 1, "maxLength": 256 },
              { "type": "boolean" }
            ]
          },
          "unit": { "type": "string", "minLength": 1, "maxLength": 64 },
          "uncertainty_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 }
        },
        "additionalProperties": false
      }
    },
    "belief_patch": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cell", "known", "obstacle", "elevation_mm", "uncertainty_mm"],
        "properties": {
          "cell": { "$ref": "common.schema.json#/$defs/GridCell" },
          "known": { "const": true },
          "obstacle": { "type": "boolean" },
          "elevation_mm": { "$ref": "common.schema.json#/$defs/SafeInteger" },
          "uncertainty_mm": { "$ref": "common.schema.json#/$defs/NonNegativeInteger" }
        },
        "additionalProperties": false
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/EvidenceRef" }
    }
  },
  "additionalProperties": false
}
