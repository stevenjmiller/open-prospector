{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprospector.invalid/v0/ipc-frame.schema.json",
  "title": "Headless runner control frames v0",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "frame",
        "run_manifest",
        "scenario",
        "fixture_root"
      ],
      "properties": {
        "frame": {
          "const": "init"
        },
        "run_manifest": {
          "$ref": "run-manifest.schema.json"
        },
        "scenario": {
          "$ref": "scenario.schema.json"
        },
        "fixture_root": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "frame",
        "run_id"
      ],
      "properties": {
        "frame": {
          "const": "ready"
        },
        "run_id": {
          "$ref": "common.schema.json#/$defs/Id"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "frame",
        "to_tick",
        "deliveries"
      ],
      "properties": {
        "frame": {
          "const": "advance"
        },
        "to_tick": {
          "$ref": "common.schema.json#/$defs/Tick"
        },
        "deliveries": {
          "type": "array",
          "items": {
            "$ref": "channel-message.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "frame",
        "intent"
      ],
      "properties": {
        "frame": {
          "const": "emit"
        },
        "intent": {
          "$ref": "outbound-intent.schema.json"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "frame",
        "at_tick"
      ],
      "properties": {
        "frame": {
          "const": "done"
        },
        "at_tick": {
          "$ref": "common.schema.json#/$defs/Tick"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "frame",
        "at_tick"
      ],
      "properties": {
        "frame": {
          "const": "checkpoint"
        },
        "at_tick": {
          "$ref": "common.schema.json#/$defs/Tick"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "frame",
        "at_tick",
        "state_hash"
      ],
      "properties": {
        "frame": {
          "const": "checkpoint-result"
        },
        "at_tick": {
          "$ref": "common.schema.json#/$defs/Tick"
        },
        "state_hash": {
          "$ref": "common.schema.json#/$defs/Hash"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "frame"
      ],
      "properties": {
        "frame": {
          "const": "shutdown"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "frame",
        "at_tick"
      ],
      "properties": {
        "frame": {
          "const": "stopped"
        },
        "at_tick": {
          "$ref": "common.schema.json#/$defs/Tick"
        }
      },
      "additionalProperties": false
    }
  ]
}
